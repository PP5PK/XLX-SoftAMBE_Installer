+  int j, errs;
+  char *ambe, gin[24], gout[24];
+
+  ambe = ambe_d;
+  // just copy C0
+  for (j = 23; j > 11; j--)
+    {
+      *ambe = ambe_fr[0][j];
+      ambe++;
+    }
+
+  // ecc and copy C1
+  for (j = 0; j < 23; j++)
+    {
+      gin[j] = ambe_fr[1][j];
+    }
+  errs = mbe_golay2312 (gin, gout);
+  for (j = 22; j > 10; j--)
+    {
+      *ambe = gout[j];
+      ambe++;
+    }
+
+  // just copy C2
+  for (j = 10; j >= 0; j--)
+    {
+      *ambe = ambe_fr[2][j];
+      ambe++;
+    }
+
+  // just copy C3
+  for (j = 13; j >= 0; j--)
+    {
+      *ambe = ambe_fr[3][j];
+      ambe++;
+    }
+
+  return (errs);
+}
