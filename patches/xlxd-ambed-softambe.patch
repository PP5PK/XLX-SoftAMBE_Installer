diff --git a/ambed/swvocoder/mbe/ambe.cpp b/ambed/swvocoder/mbe/ambe.cpp
new file mode 100644
index 0000000..a684521
--- /dev/null
+++ b/ambed/swvocoder/mbe/ambe.cpp
@@ -0,0 +1,1346 @@
+/*
+ * Copyright (C) 2010 mbelib Author
+ * GPG Key ID: 0xEA5EFE2C (9E7A 5527 9CDC EBF7 BF1B  D772 4F98 E863 EA5E FE2C)
+ *
