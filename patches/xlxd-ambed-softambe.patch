+#include "main.h"
+#include <cstring>
+#include <cstdlib>
+#include <cmath>
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+#include "ctimepoint.h"
+#include "cambepacket.h"
+#include "cvoicepacket.h"
+#include "csoftambeinterface.h"
+#include "mbe/mbevocoder.h"   // from swvocoder/
+
+#define SOFTAMBE_PCM_SAMPLES    160
+#define SOFTAMBE_DB_PER_LOG2    6.0206f     // 20 * log10(2)
+
+// Reads an integer setting from the environment, falling back to the
+// default when unset or invalid, and clamps it to [iMin, iMax].
+static int ReadIntEnv(const char *name, int iDefault, int iMin, int iMax)
+{
+    const char *env = ::getenv(name);
+    if ( (env == NULL) || (*env == 0) )
+    {
+        return iDefault;
+    }
+    char *end = NULL;
+    long val = ::strtol(env, &end, 10);
+    if ( (end == env) || (*end != 0) )
+    {
+        std::cout << "SoftAMBE: invalid " << name << "=\"" << env << "\", using " << iDefault << std::endl;
+        return iDefault;
+    }
+    if ( val > iMax ) val = iMax;
+    if ( val < iMin ) val = iMin;
+    return (int)val;
+}
+
+// Gains in dB are clamped to +/- SOFTAMBE_GAIN_LIMIT
+static int ReadGainEnv(const char *name, int iDefault)
+{
+    return ReadIntEnv(name, iDefault, -SOFTAMBE_GAIN_LIMIT, SOFTAMBE_GAIN_LIMIT);
+}
+
+////////////////////////////////////////////////////////////////////////////////////////
+// constructor
+
+CSoftAmbeInterface::CSoftAmbeInterface(int iNbPairs)
+    : CVocodecInterface()
+{
+    m_iNbPairs = MAX(0, MIN(iNbPairs, SOFTAMBE_MAX_PAIRS));
+    m_iIdleResetMs = SOFTAMBE_IDLE_RESET_MS;
+    m_fGateRatio = SOFTAMBE_GATE_RATIO;
+    m_fGateMaxDb = SOFTAMBE_GATE_MAX_DB;
+    m_iGateHoldFrames = SOFTAMBE_GATE_HOLD_MS / SOFTAMBE_FRAME_MS;
+    m_fGateReleaseDb = 1.5f;
+}
+
+////////////////////////////////////////////////////////////////////////////////////////
+// destructor
+
+CSoftAmbeInterface::~CSoftAmbeInterface()
+{
+    // stop thread first, vocoders are used from it
+    m_bStopThread = true;
+    if ( m_pThread != NULL )
+    {
+        m_pThread->join();
+        delete m_pThread;
+        m_pThread = NULL;
+    }
+
+    for ( size_t i = 0; i < m_Decoders.size(); i++ )
+    {
+        delete m_Decoders[i];
+        delete m_Encoders[i];
+    }
+    m_Decoders.clear();
+    m_Encoders.clear();
+}
+
+////////////////////////////////////////////////////////////////////////////////////////
+// initialization
+
+bool CSoftAmbeInterface::Init(void)
+{
+    if ( m_iNbPairs == 0 )
+    {
+        return false;
+    }
+
+    std::cout << "Opening SoftAMBE software vocoder : " << m_iNbPairs << " pair(s)" << std::endl;
+
+    auto now = std::chrono::steady_clock::now();
+    for ( int i = 0; i < GetNbChannels(); i++ )
+    {
+        m_Decoders.push_back(new MBEVocoder());
+        m_Encoders.push_back(new MBEVocoder());
+        m_LastDecode.push_back(now);
+        m_LastEncode.push_back(now);
+    }
+
+    LoadSettings();
+    m_Preproc.assign(GetNbChannels(), CSoftPreproc());
+
+    // starts the thread
+    return CVocodecInterface::Init();
+}
+
+int CSoftAmbeInterface::CreateChannels(std::vector<CVocodecChannel *> *channels)
+{
+    int n = 0;
+    for ( int i = 0; i < m_iNbPairs; i++ )
+    {
+        int iDstar = 2 * i;
+        int iDmr   = 2 * i + 1;
+        CVocodecChannel *Channel;
+
+        // D-Star -> DMR
+        Channel = new CVocodecChannel(this, iDstar, this, iDmr, 0);
+        channels->push_back(Channel);
+        AddChannel(Channel);
+        n++;
+
+        // DMR -> D-Star
+        Channel = new CVocodecChannel(this, iDmr, this, iDstar, 0);
+        channels->push_back(Channel);
+        AddChannel(Channel);
+        n++;
+    }
+    return n;
+}
+
+////////////////////////////////////////////////////////////////////////////////////////
+// manage channels
+
+uint8 CSoftAmbeInterface::GetChannelCodec(int iCh) const
+{
+    if ( (iCh < 0) || (iCh >= GetNbChannels()) )
+    {
+        return CODEC_NONE;
+    }
+    return ((iCh % 2) == 0) ? CODEC_AMBEPLUS : CODEC_AMBE2PLUS;
+}
+
+CVocodecChannel *CSoftAmbeInterface::GetChannelWithChannelIn(int iCh)
+{
+    for ( size_t i = 0; i < m_Channels.size(); i++ )
+    {
+        if ( m_Channels[i]->IsInterfaceIn(this) && (m_Channels[i]->GetChannelIn() == iCh) )
+        {
+            return m_Channels[i];
+        }
+    }
+    return NULL;
+}
+
+CVocodecChannel *CSoftAmbeInterface::GetChannelWithChannelOut(int iCh)
+{
+    for ( size_t i = 0; i < m_Channels.size(); i++ )
+    {
+        if ( m_Channels[i]->IsInterfaceOut(this) && (m_Channels[i]->GetChannelOut() == iCh) )
+        {
+            return m_Channels[i];
+        }
+    }
+    return NULL;
+}
+
+////////////////////////////////////////////////////////////////////////////////////////
+// task
+
+void CSoftAmbeInterface::Task(void)
+{
+    bool bWorked;
+    do
+    {
+        bWorked = false;
+        for ( size_t i = 0; i < m_Channels.size(); i++ )
+        {
+            CVocodecChannel *Channel = m_Channels[i];
+            // first step: AMBE -> PCM (also feeds Codec2/IMBE soft encoders)
+            if ( Channel->IsInterfaceIn(this) )
+            {
+                bWorked |= ProcessDecoder(Channel);
+            }
+            // second step: PCM -> AMBE
+            if ( Channel->IsInterfaceOut(this) )
+            {
+                bWorked |= ProcessEncoder(Channel);
+            }
+        }
+    } while ( bWorked && !m_bStopThread );
+
+    // nothing left to do, wait a bit (frames arrive every 20 ms)
+    CTimePoint::TaskSleepFor(2);
+}
+
+bool CSoftAmbeInterface::ProcessDecoder(CVocodecChannel *Channel)
+{
+    CAmbePacket *Packet = NULL;
+
+    CPacketQueue *Queue = Channel->GetPacketQueueIn();
+    if ( !Queue->empty() )
+    {
+        Packet = (CAmbePacket *)Queue->front();
+        Queue->pop();
+    }
+    Channel->ReleasePacketQueueIn();
+
+    if ( Packet == NULL )
+    {
+        return false;
+    }
+
+    uint8 uiPid = Packet->GetPid();
+
+    int iCh = Channel->GetChannelIn();
+    ResetIfIdle(m_Decoders, m_LastDecode, iCh);
+
+    int16_t pcm[SOFTAMBE_PCM_SAMPLES];
+    ::memset(pcm, 0, sizeof(pcm));
+    if ( GetChannelCodec(iCh) == CODEC_AMBEPLUS )
+    {
+        m_Decoders[iCh]->decode_2400x1200(pcm, Packet->GetAmbe());
+    }
+    else
+    {
+        m_Decoders[iCh]->decode_2450x1150(pcm, Packet->GetAmbe());
+    }
+    delete Packet;
+
+    // CVoicePacket carries big-endian 16-bit samples, same as the DVSI chips
+    uint8 voice[SOFTAMBE_PCM_SAMPLES * 2];
+    for ( int i = 0; i < SOFTAMBE_PCM_SAMPLES; i++ )
+    {
+        voice[2 * i]     = HIBYTE(pcm[i]);
+        voice[2 * i + 1] = LOBYTE(pcm[i]);
+    }
+
+    CVoicePacket *Voice = new CVoicePacket(voice, sizeof(voice));
+    // carry the PID along, so the encoded packet goes back with the same one
+    Voice->SetPid(uiPid);
+    Channel->ProcessSignal(*Voice);
+
+    Queue = Channel->GetVoiceQueue();
+    Queue->push(Voice);
+    Channel->ReleaseVoiceQueue();
+
+    return true;
+}
+
+bool CSoftAmbeInterface::ProcessEncoder(CVocodecChannel *Channel)
+{
+    CVoicePacket *Voice = NULL;
+
+    CPacketQueue *Queue = Channel->GetVoiceQueue();
+    if ( !Queue->empty() )
+    {
+        Voice = (CVoicePacket *)Queue->front();
+        Queue->pop();
+    }
+    Channel->ReleaseVoiceQueue();
+
+    if ( Voice == NULL )
+    {
+        return false;
+    }
+
+    int iCh = Channel->GetChannelOut();
+    if ( ResetIfIdle(m_Encoders, m_LastEncode, iCh) && (iCh < (int)m_Preproc.size()) )
+    {
+        m_Preproc[iCh].Reset();
+    }
+
+    int16_t pcm[SOFTAMBE_PCM_SAMPLES];
+    ::memset(pcm, 0, sizeof(pcm));
+    const uint8 *voice = Voice->GetVoice();
+    int n = MIN(Voice->GetVoiceSize() / 2, SOFTAMBE_PCM_SAMPLES);
+    for ( int i = 0; i < n; i++ )
+    {
+        pcm[i] = (int16_t)MAKEWORD(voice[2 * i + 1], voice[2 * i]);
+    }
+    uint8 uiPid = Voice->GetPid();
+    delete Voice;
+
+    uint8 ambe[AMBE_SIZE];
+    uint8 uiCodec = GetChannelCodec(iCh);
+    if ( uiCodec == CODEC_AMBEPLUS )
+    {
+        const CSoftPathSettings &path = m_Path[SOFTAMBE_PATH_TO_DSTAR];
+        float fGateDb = Preprocess(iCh, path, pcm, SOFTAMBE_PCM_SAMPLES);
+        m_Encoders[iCh]->set_encode_gain_log2(path.fGainLog2 - fGateDb / SOFTAMBE_DB_PER_LOG2);
+        m_Encoders[iCh]->encode_2400x1200(pcm, ambe);
+    }
+    else
+    {
+        const CSoftPathSettings &path = m_Path[SOFTAMBE_PATH_TO_DMR];
+        float fGateDb = Preprocess(iCh, path, pcm, SOFTAMBE_PCM_SAMPLES);
+        m_Encoders[iCh]->set_encode_gain_log2(path.fGainLog2 - fGateDb / SOFTAMBE_DB_PER_LOG2);
+        m_Encoders[iCh]->encode_2450x1150(pcm, ambe);
+    }
+
+    CAmbePacket *Packet = new CAmbePacket(uiPid, uiCodec, ambe);
+    Queue = Channel->GetPacketQueueOut();
+    Queue->push(Packet);
+    Channel->ReleasePacketQueueOut();
+
+    return true;
+}
+
+bool CSoftAmbeInterface::ResetIfIdle(std::vector<MBEVocoder *> &vocoders,
+                                     std::vector<std::chrono::steady_clock::time_point> &last, int iCh)
+{
+    auto now = std::chrono::steady_clock::now();
+    auto idle = std::chrono::duration_cast<std::chrono::milliseconds>(now - last[iCh]).count();
+    bool bReset = false;
+    if ( idle > m_iIdleResetMs )
+    {
+        delete vocoders[iCh];
+        vocoders[iCh] = new MBEVocoder();
+        bReset = true;
+    }
+    last[iCh] = now;
+    return bReset;
+}
+
+////////////////////////////////////////////////////////////////////////////////////////
+// settings
+
+static void MakeHighPass(CSoftBiquad &f, float fHz)
+{
+    // 2nd order Butterworth high-pass (RBJ cookbook), fs = 8 kHz
+    float w = 2.0f * (float)M_PI * fHz / 8000.0f;
+    float al = ::sinf(w) / (2.0f * 0.7071f), cs = ::cosf(w), a0 = 1.0f + al;
+    f.b0 = ((1.0f + cs) / 2.0f) / a0;
+    f.b1 = -(1.0f + cs) / a0;
+    f.b2 = ((1.0f + cs) / 2.0f) / a0;
+    f.a1 = (-2.0f * cs) / a0;
+    f.a2 = (1.0f - al) / a0;
+}
+
+static void MakePeak(CSoftBiquad &f, float fHz, float fQ, float fGainDb)
+{
+    // peaking EQ (RBJ cookbook), fs = 8 kHz
+    float A = ::powf(10.0f, fGainDb / 40.0f);
+    float w = 2.0f * (float)M_PI * fHz / 8000.0f;
+    float al = ::sinf(w) / (2.0f * fQ), cs = ::cosf(w), a0 = 1.0f + al / A;
+    f.b0 = (1.0f + al * A) / a0;
+    f.b1 = (-2.0f * cs) / a0;
+    f.b2 = (1.0f - al * A) / a0;
+    f.a1 = (-2.0f * cs) / a0;
+    f.a2 = (1.0f - al / A) / a0;
+}
+
+void CSoftAmbeInterface::LoadSettings(void)
+{
+    m_iIdleResetMs = ReadIntEnv(SOFTAMBE_ENV_IDLE_RESET_MS, SOFTAMBE_IDLE_RESET_MS, 100, 5000);
+
+    int iLowCut = ReadIntEnv(SOFTAMBE_ENV_EQ_LOWCUT_HZ, SOFTAMBE_EQ_LOWCUT_HZ, 0, 600);
+    int iPeak   = ReadIntEnv(SOFTAMBE_ENV_EQ_PEAK_HZ, SOFTAMBE_EQ_PEAK_HZ, 500, 3500);
+
+    m_fGateRatio = (float)ReadIntEnv(SOFTAMBE_ENV_GATE_RATIO, SOFTAMBE_GATE_RATIO, 1, 10);
+    m_fGateMaxDb = (float)ReadIntEnv(SOFTAMBE_ENV_GATE_MAX_DB, SOFTAMBE_GATE_MAX_DB, 0, 40);
+    int iHoldMs = ReadIntEnv(SOFTAMBE_ENV_GATE_HOLD_MS, SOFTAMBE_GATE_HOLD_MS, 0, 1000);
+    int iRelMs  = ReadIntEnv(SOFTAMBE_ENV_GATE_RELEASE_MS, SOFTAMBE_GATE_RELEASE_MS, SOFTAMBE_FRAME_MS, 2000);
+    m_iGateHoldFrames = iHoldMs / SOFTAMBE_FRAME_MS;
+    m_fGateReleaseDb = m_fGateMaxDb * (float)SOFTAMBE_FRAME_MS / (float)iRelMs;
+
+    const char *names[2][3] = {
+        { SOFTAMBE_ENV_GAIN_TO_DSTAR, SOFTAMBE_ENV_EQ_TO_DSTAR, SOFTAMBE_ENV_GATE_TO_DSTAR },
+        { SOFTAMBE_ENV_GAIN_TO_DMR,   SOFTAMBE_ENV_EQ_TO_DMR,   SOFTAMBE_ENV_GATE_TO_DMR   } };
+    const int defaults[2][3] = {
+        { SOFTAMBE_GAIN_TO_DSTAR, SOFTAMBE_EQ_TO_DSTAR, SOFTAMBE_GATE_TO_DSTAR },
+        { SOFTAMBE_GAIN_TO_DMR,   SOFTAMBE_EQ_TO_DMR,   SOFTAMBE_GATE_TO_DMR   } };
+    const char *labels[2] = { "DMR/YSF -> D-Star", "D-Star -> DMR/YSF" };
+
+    for ( int p = 0; p < 2; p++ )
+    {
+        CSoftPathSettings &path = m_Path[p];
+        path.iGainDb   = ReadGainEnv(names[p][0], defaults[p][0]);
+        path.iEqDb     = ReadIntEnv(names[p][1], defaults[p][1], 0, SOFTAMBE_EQ_LIMIT);
+        path.iGateDbfs = ReadIntEnv(names[p][2], defaults[p][2], -90, 0);
+        path.fGainLog2 = (float)path.iGainDb / SOFTAMBE_DB_PER_LOG2;
+        if ( iLowCut > 0 )
+        {
+            MakeHighPass(path.hpf, (float)iLowCut);
+        }
+        MakePeak(path.peak, (float)iPeak, SOFTAMBE_EQ_PEAK_Q, (float)path.iEqDb);
+
+        std::cout << "SoftAMBE " << labels[p] << " : gain " << path.iGainDb << " dB, equalizer ";
+        if ( path.iEqDb != 0 ) std::cout << "+" << path.iEqDb << " dB"; else std::cout << "off";
+        std::cout << ", expander ";
+        if ( path.iGateDbfs != 0 ) std::cout << path.iGateDbfs << " dBFS"; else std::cout << "off";
+        std::cout << std::endl;
+    }
+    std::cout << "SoftAMBE equalizer : low cut " << iLowCut << " Hz, peak " << iPeak << " Hz"
+              << " | expander : ratio " << (int)m_fGateRatio << ", max " << (int)m_fGateMaxDb << " dB"
+              << ", hold " << iHoldMs << " ms, release " << iRelMs << " ms"
+              << " | idle reset " << m_iIdleResetMs << " ms" << std::endl;
+}
+
+////////////////////////////////////////////////////////////////////////////////////////
+// pre-processing before the encoder
+
+float CSoftAmbeInterface::Preprocess(int iCh, const CSoftPathSettings &path, int16_t *pcm, int n)
+{
+    if ( (iCh < 0) || (iCh >= (int)m_Preproc.size()) )
+    {
+        return 0.0f;
+    }
+    if ( (path.iEqDb == 0) && (path.iGateDbfs == 0) )
+    {
+        return 0.0f;
+    }
+    CSoftPreproc &st = m_Preproc[iCh];
+
+    // level of the decoded frame, before equalization
+    float fEnergy = 0.0f;
+    for ( int i = 0; i < n; i++ )
+    {
+        float x = (float)pcm[i] / 32768.0f;
+        fEnergy += x * x;
+    }
+    float fLevelDb = 10.0f * ::log10f(fEnergy / (float)n + 1e-10f);
+
+    // equalizer, coefficients from the path settings, state per channel
+    if ( path.iEqDb != 0 )
+    {
+        st.hpf.b0 = path.hpf.b0; st.hpf.b1 = path.hpf.b1; st.hpf.b2 = path.hpf.b2;
+        st.hpf.a1 = path.hpf.a1; st.hpf.a2 = path.hpf.a2;
+        st.peak.b0 = path.peak.b0; st.peak.b1 = path.peak.b1; st.peak.b2 = path.peak.b2;
+        st.peak.a1 = path.peak.a1; st.peak.a2 = path.peak.a2;
+        for ( int i = 0; i < n; i++ )
+        {
+            float y = st.peak.Process(st.hpf.Process((float)pcm[i]));
+            if ( y >  32767.0f ) y =  32767.0f;
+            if ( y < -32768.0f ) y = -32768.0f;
+            pcm[i] = (int16_t)y;
+        }
+    }
+
+    // downward expander: opens at once, holds, then closes slowly
+    if ( path.iGateDbfs == 0 )
+    {
+        return 0.0f;
+    }
+    float fTarget = 0.0f;
+    if ( fLevelDb < (float)path.iGateDbfs )
+    {
+        fTarget = ((float)path.iGateDbfs - fLevelDb) * m_fGateRatio;
+        if ( fTarget > m_fGateMaxDb ) fTarget = m_fGateMaxDb;
+    }
+    if ( fTarget <= st.fGateDb )
+    {
+        st.fGateDb = fTarget;
+        if ( fTarget == 0.0f ) st.iHold = m_iGateHoldFrames;
+    }
+    else if ( st.iHold > 0 )
+    {
+        st.iHold--;
+    }
+    else
+    {
+        st.fGateDb += MIN(fTarget - st.fGateDb, m_fGateReleaseDb);
+    }
+    return st.fGateDb;
+}
diff --git a/ambed/csoftambeinterface.h b/ambed/csoftambeinterface.h
new file mode 100644
index 0000000..5f85f0d
--- /dev/null
+++ b/ambed/csoftambeinterface.h
@@ -0,0 +1,211 @@
+//
+//  csoftambeinterface.h
+//  ambed
+//
+//  Software AMBE (D-Star, 3600x2400) / AMBE+2 (DMR/YSF/NXDN, 3600x2450)
+//  vocoder interface. Replaces a DVSI USB-3xxx device with the open source
+//  software vocoder from DroidStar (mbelib + OP25 AMBE encoder + Pavel Yazev
+//  IMBE analysis).
+//
+// ----------------------------------------------------------------------------
+//    This file is part of ambed.
+//
+//    xlxd is free software: you can redistribute it and/or modify
+//    it under the terms of the GNU General Public License as published by
+//    the Free Software Foundation, either version 3 of the License, or
+//    (at your option) any later version.
+//
+//    xlxd is distributed in the hope that it will be useful,
+//    but WITHOUT ANY WARRANTY; without even the implied warranty of
+//    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+//    GNU General Public License for more details.
+//
+//    You should have received a copy of the GNU General Public License
+//    along with Foobar.  If not, see <http://www.gnu.org/licenses/>.
+// ----------------------------------------------------------------------------
+
+#ifndef csoftambeinterface_h
+#define csoftambeinterface_h
+
+#include <chrono>
+#include "cvocodecinterface.h"
+
+class MBEVocoder;
+
+////////////////////////////////////////////////////////////////////////////////////////
+// define
+
+// Environment variable holding the number of software transcoding pairs.
+// Each pair provides one D-Star -> DMR and one DMR -> D-Star channel,
+// exactly like one half of a USB-3003 pair. 0 or unset disables it.
+#define SOFTAMBE_ENV_PAIRS          "AMBED_SOFT_PAIRS"
+#define SOFTAMBE_MAX_PAIRS          16
+
+// All audio settings below are read at startup from environment variables,
+// normally set in /ambed/ambed.conf (EnvironmentFile= of ambed.service).
+// The values here are only the defaults used when a variable is unset.
+// Integer values; anything out of range is clamped, anything invalid
+// falls back to the default with a message in the log.
+
+// A vocoder that sees no traffic for this long is reset, so a new
+// transmission does not inherit the previous speaker's parameters.
+#define SOFTAMBE_ENV_IDLE_RESET_MS  "AMBED_SOFT_IDLE_RESET_MS"
+#define SOFTAMBE_IDLE_RESET_MS      500
+
+// Per path settings. Two paths: D-Star -> DMR/YSF (AMBE+2 encoder) and
+// DMR/YSF -> D-Star (AMBE encoder).
+//
+// GAIN (dB): output level. The software decoders are level-matched to each
+// other, but radios decode this encoder's AMBE+2 much louder and its AMBE
+// much quieter, so D-Star -> DMR/YSF needs attenuation and DMR/YSF -> D-Star
+// a boost. Defaults come from on-air tests with Yaesu and Icom radios.
+// The gain is applied to the encoder's quantized gain parameter, not to the
+// PCM: attenuating the PCM pushes quiet passages under the analysis floor
+// (harmonic amplitudes are clamped to 1), heard as a constant hiss in
+// pauses, and boosting it clips. 1 dB here is 1 dB of output level.
+//
+// EQ (dB): presence peak before the encoder, together with a low cut.
+// Radios decode this encoder's AMBE with too much energy under 400 Hz and
+// too little at 0.8-2.5 kHz (boomy, muffled), so it is on for DMR/YSF ->
+// D-Star. 0 disables the whole equalizer of that path.
+//
+// GATE (dBFS): downward expander threshold. Frames whose decoded level is
+// under it are attenuated on the encoder gain, so background noise in
+// pauses is not raised by a large gain. 0 disables it.
+#define SOFTAMBE_ENV_GAIN_TO_DMR    "AMBED_SOFT_GAIN_DSTAR_TO_DMR"
+#define SOFTAMBE_ENV_EQ_TO_DMR      "AMBED_SOFT_EQ_DSTAR_TO_DMR"
+#define SOFTAMBE_ENV_GATE_TO_DMR    "AMBED_SOFT_GATE_DSTAR_TO_DMR"
+#define SOFTAMBE_GAIN_TO_DMR        -20
+#define SOFTAMBE_EQ_TO_DMR          0
+#define SOFTAMBE_GATE_TO_DMR        0
+
+#define SOFTAMBE_ENV_GAIN_TO_DSTAR  "AMBED_SOFT_GAIN_DMR_TO_DSTAR"
+#define SOFTAMBE_ENV_EQ_TO_DSTAR    "AMBED_SOFT_EQ_DMR_TO_DSTAR"
+#define SOFTAMBE_ENV_GATE_TO_DSTAR  "AMBED_SOFT_GATE_DMR_TO_DSTAR"
+#define SOFTAMBE_GAIN_TO_DSTAR      17
+#define SOFTAMBE_EQ_TO_DSTAR        0
+#define SOFTAMBE_GATE_TO_DSTAR      -45
+
+#define SOFTAMBE_GAIN_LIMIT         24      // gains accepted in +/- this, dB
+#define SOFTAMBE_EQ_LIMIT           12      // EQ accepted in 0..this, dB
+
+// Equalizer shape, shared by both paths
+#define SOFTAMBE_ENV_EQ_LOWCUT_HZ   "AMBED_SOFT_EQ_LOWCUT_HZ"   // 2nd order high-pass, 0 = none
+#define SOFTAMBE_EQ_LOWCUT_HZ       250
+#define SOFTAMBE_ENV_EQ_PEAK_HZ     "AMBED_SOFT_EQ_PEAK_HZ"     // presence peak centre
+#define SOFTAMBE_EQ_PEAK_HZ         1800
+#define SOFTAMBE_EQ_PEAK_Q          0.6f                        // broad, about 0.8-3 kHz
+
+// Expander shape, shared by both paths. It opens at once when speech
+// returns, holds, then closes slowly, so word endings are kept.
+#define SOFTAMBE_ENV_GATE_RATIO     "AMBED_SOFT_GATE_RATIO"     // dB of cut per dB under threshold
+#define SOFTAMBE_GATE_RATIO         2
+#define SOFTAMBE_ENV_GATE_MAX_DB    "AMBED_SOFT_GATE_MAX_DB"    // largest cut
+#define SOFTAMBE_GATE_MAX_DB        20
+#define SOFTAMBE_ENV_GATE_HOLD_MS   "AMBED_SOFT_GATE_HOLD_MS"   // stays open after speech
+#define SOFTAMBE_GATE_HOLD_MS       100
+#define SOFTAMBE_ENV_GATE_RELEASE_MS "AMBED_SOFT_GATE_RELEASE_MS" // time to close fully
+#define SOFTAMBE_GATE_RELEASE_MS    270
+
+#define SOFTAMBE_FRAME_MS           20
+#define SOFTAMBE_PATH_TO_DSTAR      0
+#define SOFTAMBE_PATH_TO_DMR        1
+
+// One RBJ biquad, direct form I
+struct CSoftBiquad
+{
+    float b0, b1, b2, a1, a2;
+    float x1, x2, y1, y2;
+    CSoftBiquad() : b0(1), b1(0), b2(0), a1(0), a2(0), x1(0), x2(0), y1(0), y2(0) {}
+    void  Reset(void)  { x1 = x2 = y1 = y2 = 0; }
+    float Process(float x)
+    {
+        float y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
+        x2 = x1; x1 = x; y2 = y1; y1 = y;
+        return y;
+    }
+};
+
+// Settings of one path, read once at startup
+struct CSoftPathSettings
+{
+    int         iGainDb;
+    int         iEqDb;          // 0 = equalizer off
+    int         iGateDbfs;      // 0 = expander off
+    float       fGainLog2;      // iGainDb in encoder gain units
+    CSoftBiquad hpf;            // filter coefficients, used as prototypes
+    CSoftBiquad peak;
+    CSoftPathSettings() : iGainDb(0), iEqDb(0), iGateDbfs(0), fGainLog2(0) {}
+};
+
+// Per-channel pre-processing state (filters and expander)
+struct CSoftPreproc
+{
+    CSoftBiquad hpf;
+    CSoftBiquad peak;
+    float       fGateDb;        // current expander attenuation, dB
+    int         iHold;          // frames left before the expander may close
+    CSoftPreproc() : fGateDb(0), iHold(0) {}
+    void Reset(void)            { hpf.Reset(); peak.Reset(); fGateDb = 0; iHold = 0; }
+};
+
+////////////////////////////////////////////////////////////////////////////////////////
+// class
+
+class CSoftAmbeInterface : public CVocodecInterface
+{
+public:
+    // constructors
+    CSoftAmbeInterface(int iNbPairs);
+
+    // destructor
+    virtual ~CSoftAmbeInterface();
+
+    // initialization
+    bool Init(void);
+
+    // get
+    const char *GetName(void) const                 { return "SoftAMBE"; }
+    const char *GetSerial(void) const               { return "software"; }
+
+    // manage channels
+    // Internal channel index layout: even = AMBE (D-Star), odd = AMBE+2 (DMR)
+    int   GetNbChannels(void) const                 { return m_iNbPairs * 2; }
+    uint8 GetChannelCodec(int) const;
+    CVocodecChannel *GetChannelWithChannelIn(int);
+    CVocodecChannel *GetChannelWithChannelOut(int);
+
+    // creates the CVocodecChannel objects and appends them to the list
+    int CreateChannels(std::vector<CVocodecChannel *> *channels);
+
+    // task
+    void Task(void);
+
+protected:
+    // helpers
+    bool ProcessDecoder(CVocodecChannel *Channel);
+    bool ProcessEncoder(CVocodecChannel *Channel);
+    bool ResetIfIdle(std::vector<MBEVocoder *> &vocoders, std::vector<std::chrono::steady_clock::time_point> &last, int iCh);
+    void LoadSettings(void);
+    // equalizes pcm in place, returns the expander attenuation (dB, >= 0)
+    float Preprocess(int iCh, const CSoftPathSettings &path, int16_t *pcm, int n);
+
+protected:
+    int                         m_iNbPairs;
+    CSoftPathSettings           m_Path[2];            // SOFTAMBE_PATH_TO_DSTAR / _TO_DMR
+    int                         m_iIdleResetMs;
+    float                       m_fGateRatio;
+    float                       m_fGateMaxDb;
+    int                         m_iGateHoldFrames;
+    float                       m_fGateReleaseDb;     // per frame
+    std::vector<CSoftPreproc>   m_Preproc;            // one per internal channel
+
+    // one decoder and one encoder per internal channel, both are stateful
+    std::vector<MBEVocoder *>   m_Decoders;
+    std::vector<MBEVocoder *>   m_Encoders;
+    std::vector<std::chrono::steady_clock::time_point> m_LastDecode;
+    std::vector<std::chrono::steady_clock::time_point> m_LastEncode;
+};
+
+////////////////////////////////////////////////////////////////////////////////////////
+#endif /* csoftambeinterface_h */
