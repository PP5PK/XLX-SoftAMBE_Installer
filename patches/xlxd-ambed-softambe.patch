+void
+mbe_dumpAmbe2450Data (char *ambe_d)
+{
+
+  int i;
+  char *ambe;
+
+  ambe = ambe_d;
+  for (i = 0; i < 49; i++)
+    {
+      printf ("%i", *ambe);
+      ambe++;
