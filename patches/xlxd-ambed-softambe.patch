diff --git a/ambed/makefile b/ambed/makefile
index c556a28..e60c142 100644
--- a/ambed/makefile
+++ b/ambed/makefile
@@ -5,16 +5,39 @@ SOURCES=$(wildcard *.cpp)
 OBJECTS=$(SOURCES:.cpp=.o)
 EXECUTABLE=ambed
 
+# software vocoder (DroidStar mbe + Pavel Yazev IMBE), always built
+SW_SOURCES=$(wildcard swvocoder/mbe/*.cpp) $(wildcard swvocoder/imbe_vocoder/*.cc)
+SW_OBJECTS=$(patsubst %.cc,%.o,$(SW_SOURCES:.cpp=.o))
+SW_CFLAGS=-O2 -Iswvocoder -Iswvocoder/imbe_vocoder
+
+# make NO_FTDI=1 builds a software-only ambed that does not need libftd2xx
+ifeq ($(NO_FTDI),1)
+FTDI_OBJECTS=swvocoder/ftd2xx_stub.o
+FTDI_LIBS=
+else
+FTDI_OBJECTS=
+FTDI_LIBS=-lftd2xx -Wl,-rpath,/usr/local/lib
+endif
+
 all: $(SOURCES) $(EXECUTABLE)
 
-$(EXECUTABLE): $(OBJECTS)
-	$(CC) $(LDFLAGS) $(OBJECTS) -lftd2xx -Wl,-rpath,/usr/local/lib -o $@
+$(EXECUTABLE): $(OBJECTS) $(SW_OBJECTS) $(FTDI_OBJECTS)
+	$(CC) $(LDFLAGS) $(OBJECTS) $(SW_OBJECTS) $(FTDI_OBJECTS) $(FTDI_LIBS) -o $@
 
 .cpp.o:
-	$(CC) $(CFLAGS) $< -o $@
+	$(CC) $(CFLAGS) -Iswvocoder $< -o $@
+
+swvocoder/mbe/%.o: swvocoder/mbe/%.cpp
+	$(CC) $(CFLAGS) $(SW_CFLAGS) $< -o $@
+
+swvocoder/imbe_vocoder/%.o: swvocoder/imbe_vocoder/%.cc
+	$(CC) $(CFLAGS) $(SW_CFLAGS) $< -o $@
+
+swvocoder/ftd2xx_stub.o: swvocoder/ftd2xx_stub.c
+	gcc -c $< -o $@
 
 clean:
-	$(RM) $(EXECUTABLE) *.o
+	$(RM) $(EXECUTABLE) *.o swvocoder/mbe/*.o swvocoder/imbe_vocoder/*.o swvocoder/*.o
 
 install:
 	mkdir -p /ambed
